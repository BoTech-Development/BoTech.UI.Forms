        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <Title>BoTech.UI.Forms.Avalonia.Demo.Browser</Title>
        <Version>1.0.4-alpha</Version>
        <Copyright>All Rights Reserved!</Copyright>
        <PackageProjectUrl>https://www.botech.dev</PackageProjectUrl>
        <PackageIcon>BoTechLogoSmall.png</PackageIcon>
