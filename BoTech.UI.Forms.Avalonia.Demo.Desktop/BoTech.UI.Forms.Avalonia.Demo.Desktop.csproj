<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Version>1.0.5-alpha</Version>
        <Copyright>All Rights Reserved!</Copyright>
        <PackageProjectUrl>https://www.botech.dev</PackageProjectUrl>
        <PackageIcon>BoTechLogoSmall.png</PackageIcon>
        <Authors>www.botech.dev</Authors>
        <AssemblyVersion>1.0.5.0</AssemblyVersion>
        <RepositoryUrl>https://github.com/BoTech-Development/BoTech.UI.Forms/</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BoTech.UI.Forms.Avalonia.Demo\BoTech.UI.Forms.Avalonia.Demo.csproj" />
    </ItemGroup>
</Project>
