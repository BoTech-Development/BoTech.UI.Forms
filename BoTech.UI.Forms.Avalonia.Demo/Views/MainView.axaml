            <Button Margin="0,0,5,0">
                <avalonia:MaterialIcon Kind="ArrowLeftBoldCircleOutline" IconSize="24" />
            </Button>
            <StackPanel Orientation="Vertical">
                <ProgressBar Maximum="100" 
                             Value="25"
                             Margin="0,3,0,3"/>
                <Border CornerRadius="4"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Background="LightGray"
                        Opacity="5">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="10"
                                Margin="5,0,0,0">
                            <avalonia:MaterialIcon Kind="AboutCircle" IconSize="48" />
                        </Border>
                        <StackPanel Orientation="Vertical"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold"
                                       Text="Personal Info" />
                            <TextBlock Text="We need some personal Info to verify your identity." />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="DemiBold"
