            </StackPanel>
            <Button Margin="5,0,0,0">
                <avalonia:MaterialIcon Kind="ArrowRightBoldCircleOutline" IconSize="24" />
            </Button>
        </StackPanel>
        
       <!-- <starInput:StarInputControl Minimum="1"/>-->
        <TextBlock Text="Binding Test:" />
        <ContentControl Content="{Binding Content}" />
        <TextBlock Text="BoTech.UI.Forms test:" />
        <Button Command="{Binding OnOpenDescription}">
            Open all Description Blocks
        </Button>
        <TextBlock Text="Render result:" />
        <ContentControl Content="{Binding Form}" />

    </StackPanel>

</UserControl>